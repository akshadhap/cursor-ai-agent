enum AgentType {
  LEAD_INGESTION
  LEAD_QUALIFIER
  LEAD_PRIORITIZER
  LEAD_COLD_OUTREACH
  LEAD_FOLLOWUP
}

enum ExecutionStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum LeadStatus {
  QUALIFIED
  NOT_QUALIFIED
  IN_REVIEW
}

enum EmailStatus {
  NOT_SENT
  SENT
  DELIVERED
  OPENED
  BOUNCED
}

enum LeadSource {
  WEBFORM
  EXCEL
  CRM
}

enum SmtpSenderStatus {
  PENDING
  VERIFIED
}

model WorkflowTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  tags        String[] @default([])

  // Original workflow structure (without credentials)
  nodes       Json
  connections Json
  stickyNotes Json?

  // Metadata
  createdById String
  createdBy   User   @relation("community", fields: [createdById], references: [id], onDelete: Cascade)

  usageCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
}

// AI Workflow Generator - Scalable conversation system (one per workflow)
model AIConversationMessage {
  id         String      @id @default(cuid())
  workflowId String
  workflow   Workflow    @relation("aiMessages", fields: [workflowId], references: [id], onDelete: Cascade)
  role       MessageRole
  content    String      @db.Text
  metadata   Json? // Store suggestions, language, etc.
  sequence   Int         @default(autoincrement()) // Guaranteed ordering
  createdAt  DateTime    @default(now())

  @@index([workflowId, sequence])
  @@index([workflowId, createdAt])
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

// Standalone Agents - Independent AI agents for specialized tasks
// Each user can have only one agent of each type
model StandaloneAgent {
  id     String @id @default(cuid())
  name   String
  type   String // e.g., "AI_LEAD_GENERATOR", "COLD_WRITER", "FOLLOWUP_PRO"
  status String @default("DRAFT") // DRAFT, CONFIGURED, ACTIVE, PAUSED
  config Json   @default("{}") // Agent-specific configuration
  data   Json? // Agent data (leads, analytics, etc.)

  userId String
  user   User   @relation("standaloneAgents", fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  activatedAt DateTime?

  @@unique([userId, type])
  @@index([userId])
  @@index([type])
}

// Daily Lead Generation Tracking - Track per user daily limits
model DailyLeadQuota {
  id             String   @id @default(cuid())
  userId         String
  date           DateTime @default(now()) @db.Date // Date only, no time
  leadsGenerated Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}
