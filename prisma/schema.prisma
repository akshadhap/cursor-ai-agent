  CALENDLY
  ZENDESK
  ZOOM
  ZOHO_CRM
  AIRTABLE
  INTERCOM
  GOOGLE_SHEETS
  GOOGLE_CALENDAR
  JIRA
  TELEGRAM
  PINECONE
  AIRBNB
  EXPEDIA
  RAZORPAY
}

enum NodeType {
  INITIAL
  MANUAL_TRIGGER
  HTTP_REQUEST
  GOOGLE_FORM_TRIGGER
  STRIPE_TRIGGER
  ANTHROPIC
  GEMINI
  OPENAI
  DISCORD
  SLACK
  SENDGRID
  SMTP2GO
  WEBHOOK_TRIGGER
  WAIT
  AGENT
  MCP_CLIENT
  NOTION
  HUBSPOT
  MCP_CLIENT_TOOL
  SALESFORCE
  FIRECRAWL
  QUICKBOOKS
  SHOPIFY
  MS_TEAMS
  GOOGLE_DRIVE
  CALENDLY
  ZENDESK
  ZOOM
  ZOHO_CRM
  AIRTABLE
  INTERCOM
  GOOGLE_SHEETS
  GOOGLE_CALENDAR
  CRON_TRIGGER
  HUBSPOT_TRIGGER
  JIRA
  TELEGRAM
  PINECONE
  MCP_TRIGGER
  TELEGRAM_TRIGGER
  AIRBNB
  EXPEDIA
  RAZORPAY
